# Public values only. The EXPO_PUBLIC_ ones end up inside the app bundle, and
# APPLE_TEAM_ID (below) in the app config of the native build, so nothing that
# must stay secret belongs in this file or in .env.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STREAM_ENDPOINT=
EXPO_PUBLIC_STREAM_CLIENT_NAME=
EXPO_PUBLIC_STREAM_CLIENT_VERSION=

# Not a bundle value: read by app.config.ts at build time for local iOS signing
# (ios.appleTeamId). It has no EXPO_PUBLIC_ prefix, so it is not inlined into the
# JS bundle, but it does end up in the app config embedded in the native build,
# like any app.config.ts value. That is fine: the Team ID is public, not a
# secret. It is the 10-character Team ID of your Apple developer account, shown
# under Membership details when you sign in to your developer account. The repo
# does not version it, so never commit it.
APPLE_TEAM_ID=
