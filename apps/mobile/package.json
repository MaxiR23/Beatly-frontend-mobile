{
  "name": "@beatly/mobile",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "expo start",
    "test": "jest"
  },
  "dependencies": {
    "@beatly/core": "workspace:*",
    "@beatly/ui": "workspace:*",
    "@expo/metro-runtime": "57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "expo": "57.0.25",
    "expo-constants": "57.0.19",
    "expo-glass-effect": "57.0.4",
    "expo-linking": "57.0.11",
    "expo-localization": "57.0.2",
    "expo-router": "57.0.23",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "i18next": "26.4.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-dom": "19.2.3",
    "test-renderer": "1.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/test/setup/glass.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|lucide-react-native))",
      "/node_modules/react-native-reanimated/plugin/"
    ],
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  }
}
